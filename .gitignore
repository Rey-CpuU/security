# ==============================================================================
# Security Team Repository .gitignore
# Prevents accidental leakage of credentials, tokens, logs, and sensitive data
# ==============================================================================

# --- Secrets, Credentials & Keys ---
*.env
*.env.*
.env
.env.*
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.cert
*.crt
*.der
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.id_*
credentials/
secrets/
*.secret
*.passwd
*.shadow
*token*
*password*
*credential*
api_key*
*apikey*
config.local.*
*.local
auth.json
service-account*.json

# --- Engagement Data, Dumps & Loot ---
loot/
scans/*.xml
scans/*.gnmap
scans/*.nmap
memory_dumps/
*.dmp
*.raw
*.pcap
*.pcapng
*.cap
*.evtx
*.vmem
*.lime
hashes.txt
passwords.txt
targets.txt
scope.txt

# --- Logs & Runtime Temporary Files ---
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.pid
crash.log

# --- Python & Environment Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Node.js Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# --- Antigravity & AI Agent Artifacts ---
.gemini/
