# ==============================================================================
# Security Team 8-Bit Cyber Operations Office GUI - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Network Configuration (Strictly local binding)
HOST=127.0.0.1
PORT=8888

# Dry Run Safety Gate (Default: true)
# When true, all harness invocations run in safe simulation mode with plan preview
DRY_RUN=true

# API Keys (Optional - only required if executing live API harnesses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
